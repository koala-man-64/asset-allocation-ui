{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run App Locally",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "pnpm: dev",
      "sourceMaps": true
    },
    {
      "name": "Open Local App",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true
    },
    {
      "name": "Playwright: Visual Tests (Headed)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "corepack",
      "runtimeArgs": [
        "pnpm",
        "exec",
        "playwright",
        "test",
        "--config",
        "playwright.visual.config.ts",
        "--grep",
        "@visual",
        "--headed",
        "--workers=1"
      ],
      "console": "integratedTerminal",
      "env": {
        "PLAYWRIGHT_PREVIEW_PORT": "4199"
      }
    },
    {
      "name": "Playwright: Functional E2E (Headed)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "corepack",
      "runtimeArgs": [
        "pnpm",
        "exec",
        "playwright",
        "test",
        "--grep-invert",
        "@visual",
        "--headed",
        "--workers=1"
      ],
      "console": "integratedTerminal",
      "env": {
        "PLAYWRIGHT_PREVIEW_PORT": "4200"
      }
    },
    {
      "name": "Playwright: Manual Page Picker (Headed)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "corepack",
      "runtimeArgs": ["pnpm", "test:e2e"],
      "console": "integratedTerminal",
      "env": {
        "PLAYWRIGHT_PREVIEW_PORT": "4201",
        "PLAYWRIGHT_MANUAL_HOLD_MS": "60000"
      }
    }
  ]
}
